{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ies.evaluation-report/1.0.0",
  "title": "ies.evaluation-report 1.0.0 Contract",
  "description": "Self-describing evaluation report block (metrics, charts, tables) emitted by third-party evaluator plugins.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "title",
    "evaluator",
    "metrics",
    "charts",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ies.evaluation-report" },
    "schema_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1 },
    "evaluator": { "$ref": "#/$defs/provider_ref" },
    "summary": { "type": ["string", "null"] },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "unit"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "null"], "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "x_label", "y_label", "y_unit", "series"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "x_label": { "type": "string", "minLength": 1 },
          "y_label": { "type": "string", "minLength": 1 },
          "y_unit": { "type": "string", "minLength": 1 },
          "x_unit": { "type": ["string", "null"], "minLength": 1 },
          "chart_type": { "enum": ["line", "bar", "area", "scatter"] },
          "x_values": {
            "type": "array",
            "items": { "type": ["string", "number"] }
          },
          "series": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "values"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "unit": { "type": ["string", "null"], "minLength": 1 },
                "values": {
                  "type": "array",
                  "items": { "type": ["number", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "columns", "rows"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "unit": { "type": ["string", "null"], "minLength": 1 }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "provider_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
