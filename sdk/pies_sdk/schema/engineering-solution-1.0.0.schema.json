{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ies.engineering-solution/1.0.0",
  "title": "ies.engineering-solution 1.0.0 Contract",
  "description": "Canonical business-unit engineering solution emitted by algorithm plugins or backend bounded-subprocess restoration.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "solver_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ies.engineering-solution" },
    "schema_version": { "const": "1.0.0" },
    "solver_summary": {
      "type": "object",
      "required": [
        "termination_reason",
        "math_status",
        "has_feasible_solution",
        "objective_value",
        "objective_unit",
        "best_bound",
        "relative_gap"
      ],
      "additionalProperties": false,
      "properties": {
        "termination_reason": {
          "enum": [
            "optimal",
            "time_limit",
            "infeasible",
            "unbounded",
            "not_solved"
          ]
        },
        "math_status": {
          "enum": [
            "solved",
            "feasible",
            "infeasible",
            "unbounded",
            "numeric_failure",
            "not_solved"
          ]
        },
        "has_feasible_solution": { "type": "boolean" },
        "objective_value": { "type": ["number", "null"] },
        "objective_unit": { "type": ["string", "null"], "minLength": 1 },
        "best_bound": { "type": ["number", "null"] },
        "relative_gap": { "type": ["number", "null"] },
        "solver_diagnostics": { "type": "object" }
      }
    },
    "construction_units": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["unit_id", "instance_id", "mode", "built", "scales"],
        "additionalProperties": false,
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "instance_id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["mandatory", "optional"] },
          "built": { "type": "boolean" },
          "scales": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["planning_variable_id", "value", "unit"],
              "additionalProperties": false,
              "properties": {
                "planning_variable_id": { "type": "string", "minLength": 1 },
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "series": {
      "type": ["object", "null"],
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["instance_id", "variable_id", "unit", "values"],
        "additionalProperties": false,
        "properties": {
          "instance_id": { "type": "string", "minLength": 1 },
          "variable_id": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    },
    "system_series": {
      "type": ["object", "null"],
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["block", "variable", "unit", "values"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "string", "minLength": 1 },
          "variable": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    },
    "metrics": { "type": ["object", "null"] },
    "model_sources": { "type": ["object", "null"] },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "solver_summary": {
            "type": "object",
            "properties": { "has_feasible_solution": { "const": true } },
            "required": ["has_feasible_solution"]
          }
        },
        "required": ["solver_summary"]
      },
      "then": {
        "required": ["construction_units", "series", "system_series"],
        "properties": {
          "construction_units": { "type": "array" },
          "series": { "type": "object" },
          "system_series": { "type": "object" }
        }
      }
    }
  ]
}
