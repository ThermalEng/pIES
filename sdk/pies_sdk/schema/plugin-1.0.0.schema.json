{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ies.algorithm-plugin/1.0.0",
  "title": "ies.algorithm-plugin 1.0.0 Manifest Contract",
  "description": "Unified computation plugin manifest (plugin.yaml) for predictor, generator, solver, evaluator, and algorithm stages.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "plugin_id",
    "version",
    "kind",
    "name",
    "description",
    "compatibility",
    "runtime",
    "entrypoint",
    "parameters_schema",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ies.algorithm-plugin" },
    "schema_version": { "const": "1.0.0" },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "kind": {
      "enum": ["predictor", "generator", "solver", "evaluator", "algorithm"]
    },
    "name": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "zh_cn": { "type": "string", "minLength": 1 },
        "en_us": { "type": "string", "minLength": 1 }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "pies": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["language", "python"],
      "additionalProperties": false,
      "properties": {
        "language": { "const": "python" },
        "python": {
          "type": "string",
          "pattern": "^3\\.12(\\.[0-9]+)?$"
        },
        "requirements": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z][A-Za-z0-9_]*$"
    },
    "parameters_schema": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "required": ["default", "maximum"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/resource_spec" },
        "maximum": { "$ref": "#/$defs/resource_spec" }
      }
    },
    "advanced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming_bundle": { "type": "boolean" },
        "depends_on_solve_result": { "type": "boolean" },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "supported_precisions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["low", "medium", "high"] }
        },
        "binary": {
          "type": "object",
          "required": ["executable"],
          "additionalProperties": false,
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "arguments_template": {
              "type": "array",
              "items": { "type": "string" }
            },
            "env_allowlist": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "companions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "predictor": { "$ref": "#/$defs/provider_ref" },
            "generator": { "$ref": "#/$defs/provider_ref" },
            "solver": { "$ref": "#/$defs/provider_ref" },
            "evaluator": { "$ref": "#/$defs/provider_ref" },
            "result_adapter": { "$ref": "#/$defs/provider_ref" }
          }
        },
        "extensions": { "type": "object" }
      }
    },
    "iteration": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_iterations_default": { "type": "integer", "minimum": 1 },
        "convergence_metric": { "type": "string", "minLength": 1 },
        "progress_channel": { "const": "/work/out/iterations.jsonl" }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "input", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "input": { "$ref": "#/$defs/relative_path" },
          "expected": { "$ref": "#/$defs/relative_path" }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provider_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "resource_spec": {
      "type": "object",
      "required": ["cpu", "memory_mb", "timeout_seconds", "process_limit"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "number", "exclusiveMinimum": 0 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "process_limit": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
