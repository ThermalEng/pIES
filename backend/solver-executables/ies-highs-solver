#!/usr/local/bin/python
"""HiGHS 求解适配 executable（固定入口，只接受结构化参数）。

把生成器声明的七项求解参数映射到 highspy 精确版本：真实读 MPS、
真实求解、写声明 solution 文件。不是通用脚本执行器：除 ``--version``
与 ``--self-test DIR`` 外，只接受位置固定的七参数 ``[MPS,
--solution_file, SOL, --time_limit, 秒, --random_seed, 种子]`` 及可选
尾部结构化参数 ``--acceleration_mode off|on_demand_mutex`` 与
``--threads N``，其他形状一律拒绝。只依赖标准库与精确固定的 highspy，
不导入 iesplan，不读环境变量，不访问网络/DB/对象存储。

solution 文件格式 ``HIGHS_SOLUTION_V1``（ResultAdapter 按此解析）： ::

    HIGHS_SOLUTION_V1
    model_status: HighsModelStatus.kOptimal
    has_feasible_solution: true
    objective_value: 2.5
    best_bound: 2.5
    relative_gap: 0.0
    num_columns: 2
    primal:
    0: 1.5
    1: 0.5

退出码：0 表示求解器已执行且声明文件已写出（含不可行等业务状态，
由 ResultAdapter 解释）；1 表示自检断言失败；2 表示参数形状错误、
输入不可读或写出失败等基础设施错误。
"""

from __future__ import annotations

from collections.abc import Mapping, Sequence
from contextlib import contextmanager
import math
import os
import sys
import tempfile
import time

#: 自检在给定目录内使用的输入/声明输出文件名（固定约定）。
SELF_TEST_MPS = "self-test.mps"
SELF_TEST_OUTPUT = "self-test.sol"

#: 自检内嵌最小 LP（min x1+2x2, x1+x2>=2, x1<=1.5, x>=0）：
#: 唯一最优 (1.5, 0.5)，目标值 2.5。
SELF_TEST_MPS_TEXT = """\
NAME          SELFTEST
ROWS
 N  OBJ
 G  DEMAND
COLUMNS
    X1        OBJ       1.0
    X1        DEMAND    1.0
    X2        OBJ       2.0
    X2        DEMAND    1.0
RHS
    R         DEMAND    2.0
BOUNDS
 LO BND       X1        0.0
 UP BND       X1        1.5
 LO BND       X2        0.0
ENDATA
"""
SELF_TEST_OBJECTIVE = 2.5
SELF_TEST_TOLERANCE = 1e-6


def _fail(message: str) -> int:
    sys.stderr.write(f"ies-highs-solver: {message}\n")
    sys.stderr.flush()
    return 2


def _log_stage(
    stage: str,
    event: str,
    *,
    elapsed_seconds: float | None = None,
    status: str | None = None,
) -> None:
    parts = [f"stage={stage}", f"event={event}"]
    if status is not None:
        parts.append(f"status={status}")
    if elapsed_seconds is not None:
        parts.append(f"elapsed_seconds={elapsed_seconds:.6f}")
    sys.stderr.write("ies-highs-solver: " + " ".join(parts) + "\n")
    sys.stderr.flush()


@contextmanager
def _timed_stage(stage: str):
    started = time.monotonic()
    _log_stage(stage, "start")
    status = "ok"
    try:
        yield
    except BaseException:
        status = "error"
        raise
    finally:
        _log_stage(
            stage,
            "end",
            elapsed_seconds=time.monotonic() - started,
            status=status,
        )


def _check_relative_path(value: str, name: str) -> str:
    if not value or value.startswith(("/", "-", "@")):
        raise ValueError(f"{name} 路径形态非法: {value!r}")
    if ".." in value.split("/"):
        raise ValueError(f"{name} 路径越界: {value!r}")
    return value


def _cmd_version() -> int:
    import highspy

    sys.stdout.write(f"{highspy.Highs().version()}\n")
    return 0


_SOLVE_DOMAINS = ("original", "valid_relaxation", "restricted")
_ACCELERATION_MODES = ("off", "on_demand_mutex")


def remaining_solve_budget(
    deadline: float,
    *,
    min_guard: float,
    io_margin: float,
) -> float | None:
    """Return remaining solve budget before ``deadline - io_margin``, or ``None`` if exhausted."""
    if not (math.isfinite(deadline) and math.isfinite(min_guard) and math.isfinite(io_margin)):
        raise ValueError("deadline, min_guard and io_margin must be finite")
    if min_guard < 0 or io_margin < 0:
        raise ValueError("min_guard and io_margin must be non-negative")
    remaining = deadline - time.monotonic()
    if remaining <= min_guard + io_margin:
        return None
    return remaining - io_margin


def _clamp_zero(lower: float, upper: float) -> float:
    if math.isnan(lower) or math.isnan(upper) or lower > upper:
        raise ValueError(f"非法变量上下界: [{lower!r}, {upper!r}]")
    value = min(max(0.0, lower), upper)
    if not math.isfinite(value):
        raise ValueError(f"有限占位值非有限: {value!r} (bounds=[{lower!r}, {upper!r}])")
    return value


def build_partial_warm_start(handle, discrete_values: Mapping[int, float]) -> list[float]:
    """Build full finite warm-start vector clamping unspecified columns to ``[lower, upper]``."""
    lp = handle.getLp()
    num_col = int(lp.num_col_)
    for col, raw in discrete_values.items():
        if not isinstance(col, int) or isinstance(col, bool) or col < 0 or col >= num_col:
            raise ValueError(f"热启动列索引越界: {col!r}")
        if isinstance(raw, bool):
            raise ValueError(f"热启动列 {col} 数值不可为 bool")
        val = float(raw)
        if not math.isfinite(val):
            raise ValueError(f"热启动列 {col} 非有限数值: {raw!r}")

    lowers = lp.col_lower_
    uppers = lp.col_upper_
    col_values: list[float] = []
    for col in range(num_col):
        if col in discrete_values:
            val = float(discrete_values[col])
        else:
            val = _clamp_zero(float(lowers[col]), float(uppers[col]))
        assert math.isfinite(val)
        col_values.append(val)
    return col_values


def inject_warm_start(handle, col_values: Sequence[float]):
    """Validate column length and finiteness before calling ``handle.setSolution``."""
    import highspy

    num_col = int(handle.getNumCol())
    if len(col_values) != num_col:
        raise ValueError(f"热启动列数 {len(col_values)} 与模型列数 {num_col} 不一致")
    validated: list[float] = []
    for idx, raw in enumerate(col_values):
        if isinstance(raw, bool):
            raise ValueError(f"热启动列 {idx} 数值不可为 bool")
        val = float(raw)
        if not math.isfinite(val):
            raise ValueError(f"热启动列 {idx} 非有限数值: {raw!r}")
        validated.append(val)
    solution = highspy.HighsSolution()
    solution.col_value = validated
    solution.value_valid = True
    return handle.setSolution(solution)


def _atomic_write_text(sol_path: str, content: str) -> None:
    """Atomically write ``content`` via same-directory temp file and ``os.replace``."""
    parent = os.path.dirname(sol_path) or "."
    base = os.path.basename(sol_path)
    tmp_path: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent,
            prefix=f".{base}.",
            suffix=".tmp",
            delete=False,
        ) as stream:
            tmp_path = stream.name
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp_path, sol_path)
    except BaseException:
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        raise


class VerifiedIncumbent:
    """Immutable snapshot of an original-model-verified feasible primal."""

    __slots__ = (
        "model_status",
        "objective_value",
        "best_bound",
        "relative_gap",
        "primals",
        "solve_domain",
        "original_model_verified",
        "subdomain_status",
        "subdomain_best_bound",
        "subdomain_relative_gap",
    )

    def __init__(
        self,
        *,
        model_status: str,
        objective_value: float,
        best_bound: float | None,
        relative_gap: float | None,
        primals: tuple[float, ...],
        solve_domain: str = "original",
        original_model_verified: bool = True,
        subdomain_status: str | None = None,
        subdomain_best_bound: float | None = None,
        subdomain_relative_gap: float | None = None,
    ) -> None:
        self.model_status = model_status
        self.objective_value = objective_value
        self.best_bound = best_bound
        self.relative_gap = relative_gap
        self.primals = primals
        self.solve_domain = solve_domain
        self.original_model_verified = original_model_verified
        self.subdomain_status = subdomain_status
        self.subdomain_best_bound = subdomain_best_bound
        self.subdomain_relative_gap = subdomain_relative_gap


class VerifiedIncumbentSlot:
    """Single-slot incumbent tracker with atomic persistence to ``sol_path``."""

    def __init__(self, *, sense: object = "minimize", sol_path: str | None = None) -> None:
        sense_name = str(sense)
        if sense_name in ("minimize", "ObjSense.kMinimize"):
            self.sense = "minimize"
        elif sense_name in ("maximize", "ObjSense.kMaximize"):
            self.sense = "maximize"
        else:
            raise ValueError(f"未知优化方向: {sense!r}")
        self.sol_path = sol_path
        self.incumbent: VerifiedIncumbent | None = None

    def is_better(self, objective_value: float) -> bool:
        obj = float(objective_value)
        if not math.isfinite(obj):
            raise ValueError(f"目标值非有限: {objective_value!r}")
        if self.incumbent is None:
            return True
        if self.sense == "minimize":
            return obj < self.incumbent.objective_value
        return obj > self.incumbent.objective_value

    def record(
        self,
        *,
        objective_value: float,
        primals: Sequence[float],
        model_status: object = "HighsModelStatus.kTimeLimit",
        best_bound: float | None = None,
        relative_gap: float | None = None,
        solve_domain: str = "original",
        original_model_verified: bool = True,
        subdomain_status: str | None = None,
        subdomain_best_bound: float | None = None,
        subdomain_relative_gap: float | None = None,
        sol_path: str | None = None,
    ) -> bool:
        """Record a strictly better verified primal and atomically persist ``sol_path``."""
        if not original_model_verified:
            return False
        obj = float(objective_value)
        if not math.isfinite(obj):
            raise ValueError(f"目标值非有限: {objective_value!r}")
        validated_primals = tuple(float(v) for v in primals)
        if not all(math.isfinite(v) for v in validated_primals):
            raise ValueError("主解向量包含非有限数值")
        if not self.is_better(obj):
            return False
        candidate = VerifiedIncumbent(
            model_status=str(model_status),
            objective_value=obj,
            best_bound=best_bound,
            relative_gap=relative_gap,
            primals=validated_primals,
            solve_domain=solve_domain,
            original_model_verified=True,
            subdomain_status=subdomain_status,
            subdomain_best_bound=subdomain_best_bound,
            subdomain_relative_gap=subdomain_relative_gap,
        )
        content = _format_solution_v1(
            model_status=candidate.model_status,
            feasible=True,
            objective=candidate.objective_value,
            best_bound=candidate.best_bound,
            relative_gap=candidate.relative_gap,
            primals=candidate.primals,
            solve_domain=candidate.solve_domain,
            original_model_verified=candidate.original_model_verified,
            subdomain_status=candidate.subdomain_status,
            subdomain_best_bound=candidate.subdomain_best_bound,
            subdomain_relative_gap=candidate.subdomain_relative_gap,
        )
        target_path = sol_path if sol_path is not None else self.sol_path
        if target_path is not None:
            _atomic_write_text(target_path, content)
        self.incumbent = candidate
        return True

    def record_from_handle(
        self,
        handle,
        model_status,
        *,
        original_model_verified: bool,
        solve_domain: str = "original",
        subdomain_status: str | None = None,
        subdomain_best_bound: float | None = None,
        subdomain_relative_gap: float | None = None,
        sol_path: str | None = None,
    ) -> bool:
        """Extract feasible solution from ``handle`` and record if verified and strictly better."""
        if not original_model_verified:
            return False
        feasible, objective, best_bound, gap, primals = _extract_solution_data(handle, model_status)
        if not feasible or objective is None:
            return False
        return self.record(
            objective_value=objective,
            primals=primals,
            model_status=model_status,
            best_bound=best_bound,
            relative_gap=gap,
            solve_domain=solve_domain,
            original_model_verified=True,
            subdomain_status=subdomain_status,
            subdomain_best_bound=subdomain_best_bound,
            subdomain_relative_gap=subdomain_relative_gap,
            sol_path=sol_path,
        )

    def to_solution_text(self) -> str:
        if self.incumbent is None:
            raise RuntimeError("尚未记录已核查可行解")
        inc = self.incumbent
        return _format_solution_v1(
            model_status=inc.model_status,
            feasible=True,
            objective=inc.objective_value,
            best_bound=inc.best_bound,
            relative_gap=inc.relative_gap,
            primals=inc.primals,
            solve_domain=inc.solve_domain,
            original_model_verified=inc.original_model_verified,
            subdomain_status=inc.subdomain_status,
            subdomain_best_bound=inc.subdomain_best_bound,
            subdomain_relative_gap=inc.subdomain_relative_gap,
        )


def _solve_model(
    mps_path: str,
    time_limit: float,
    seed: int,
    *,
    acceleration_mode: str = "off",
    threads: int | None = None,
):
    """读 MPS 并真实求解，返回 ``(h, model_status)``；失败抛异常。

    S1 阶段 ``on_demand_mutex`` 在无已验证互斥元数据时干净回退原路径；
    ``time_limit`` 始终在 ``readModel()`` 之后写入。
    """
    import highspy

    if acceleration_mode not in _ACCELERATION_MODES:
        raise ValueError(f"非法 acceleration_mode: {acceleration_mode!r}")
    handle = highspy.Highs()
    with _timed_stage("read_model"):
        if handle.readModel(mps_path) != highspy.HighsStatus.kOk:
            raise RuntimeError(f"MPS 读取失败: {mps_path!r}")
    handle.setOptionValue("time_limit", time_limit)
    handle.setOptionValue("random_seed", seed)
    if threads is not None:
        handle.setOptionValue("threads", threads)
    with _timed_stage("run"):
        if handle.run() == highspy.HighsStatus.kError:
            raise RuntimeError("HiGHS 求解执行错误")
    return handle, handle.getModelStatus()


def _write_solution(
    handle,
    model_status,
    sol_path: str,
    *,
    solve_domain: str = "original",
    original_model_verified: bool = True,
    subdomain_status: str | None = None,
    subdomain_best_bound: float | None = None,
    subdomain_relative_gap: float | None = None,
) -> None:
    """生成 ``HIGHS_SOLUTION_V1`` 内容并原子写出声明文件；失败抛异常。"""
    with _timed_stage("solution_write"):
        if (
            solve_domain == "original"
            and original_model_verified
            and subdomain_status is None
            and subdomain_best_bound is None
            and subdomain_relative_gap is None
        ):
            content = _solution_text(handle, model_status)
        else:
            content = _solution_text(
                handle,
                model_status,
                solve_domain=solve_domain,
                original_model_verified=original_model_verified,
                subdomain_status=subdomain_status,
                subdomain_best_bound=subdomain_best_bound,
                subdomain_relative_gap=subdomain_relative_gap,
            )
        _atomic_write_text(sol_path, content)


def _extract_solution_data(handle, model_status):
    import highspy

    solution = handle.getSolution()
    info = handle.getInfo()
    feasible = (
        model_status in (highspy.HighsModelStatus.kOptimal, highspy.HighsModelStatus.kTimeLimit)
        and solution.value_valid
        and info.primal_solution_status == highspy.SolutionStatus.kSolutionStatusFeasible
    )
    objective = float(handle.getObjectiveValue()) if feasible else None
    best_bound = gap = None
    if info.mip_node_count >= 0:
        best_bound = info.mip_dual_bound if math.isfinite(info.mip_dual_bound) else None
        gap = info.mip_gap if math.isfinite(info.mip_gap) else None
    elif model_status == highspy.HighsModelStatus.kOptimal and feasible:
        # Optimal LP has no MIP statistics; an optimal MIP may still have a
        # nonzero gap within its configured optimality tolerance.
        best_bound, gap = objective, 0.0
    primals = solution.col_value if feasible else []
    return feasible, objective, best_bound, gap, primals


def _format_solution_v1(
    *,
    model_status: object,
    feasible: bool,
    objective: float | None,
    best_bound: float | None,
    relative_gap: float | None,
    primals: Sequence[float],
    solve_domain: str = "original",
    original_model_verified: bool = True,
    subdomain_status: str | None = None,
    subdomain_best_bound: float | None = None,
    subdomain_relative_gap: float | None = None,
) -> str:
    if solve_domain not in _SOLVE_DOMAINS:
        raise ValueError(f"非法 solve_domain: {solve_domain!r}")

    def number(value):
        if value is None:
            return "none"
        num = float(value)
        if not math.isfinite(num):
            raise ValueError(f"非有限解数值: {value!r}")
        return repr(num)

    lines = [
        "HIGHS_SOLUTION_V1",
        f"model_status: {model_status}",
        f"has_feasible_solution: {str(bool(feasible)).lower()}",
        f"objective_value: {number(objective)}",
        f"best_bound: {number(best_bound)}",
        f"relative_gap: {number(relative_gap)}",
        f"num_columns: {len(primals)}",
    ]
    if solve_domain != "original" or not original_model_verified:
        lines.append(f"solve_domain: {solve_domain}")
        lines.append(f"original_model_verified: {str(bool(original_model_verified)).lower()}")
    if subdomain_status is not None:
        lines.append(f"subdomain_status: {subdomain_status}")
    if subdomain_best_bound is not None:
        lines.append(f"subdomain_best_bound: {number(subdomain_best_bound)}")
    if subdomain_relative_gap is not None:
        lines.append(f"subdomain_relative_gap: {number(subdomain_relative_gap)}")
    lines.append("primal:")
    lines.extend(f"{index}: {value!r}" for index, value in enumerate(primals))
    return "\n".join(lines) + "\n"


def _solution_text(
    handle,
    model_status,
    *,
    solve_domain: str = "original",
    original_model_verified: bool = True,
    subdomain_status: str | None = None,
    subdomain_best_bound: float | None = None,
    subdomain_relative_gap: float | None = None,
) -> str:
    feasible, objective, best_bound, gap, primals = _extract_solution_data(handle, model_status)
    return _format_solution_v1(
        model_status=model_status,
        feasible=feasible,
        objective=objective,
        best_bound=best_bound,
        relative_gap=gap,
        primals=primals,
        solve_domain=solve_domain,
        original_model_verified=original_model_verified,
        subdomain_status=subdomain_status,
        subdomain_best_bound=subdomain_best_bound,
        subdomain_relative_gap=subdomain_relative_gap,
    )


def _parse_solve_args(args: list[str]) -> tuple[str, str, float, int, str, int | None]:
    if len(args) < 7 or (len(args) - 7) % 2 != 0:
        raise ValueError(f"求解参数须为七项基础参数加可选成对选项，得到 {len(args)} 项")
    mps_path, flag1, sol_path, flag2, limit_text, flag3, seed_text = args[:7]
    _check_relative_path(mps_path, "arguments[0]")
    if flag1 != "--solution_file":
        raise ValueError("arguments[1] 须为 --solution_file")
    _check_relative_path(sol_path, "arguments[2]")
    if flag2 != "--time_limit":
        raise ValueError("arguments[3] 须为 --time_limit")
    time_limit = float(limit_text)
    if not (math.isfinite(time_limit) and time_limit > 0):
        raise ValueError("arguments[4] 须为正有限秒数")
    if flag3 != "--random_seed":
        raise ValueError("arguments[5] 须为 --random_seed")
    seed = int(seed_text, 10)
    if seed < 0:
        raise ValueError("arguments[6] 须为非负整数")

    acceleration_mode = "off"
    threads: int | None = None
    seen: set[str] = set()
    for idx in range(7, len(args), 2):
        flag, value = args[idx], args[idx + 1]
        if flag in seen:
            raise ValueError(f"重复选项: {flag!r}")
        seen.add(flag)
        if flag == "--acceleration_mode":
            if value not in _ACCELERATION_MODES:
                raise ValueError(f"--acceleration_mode 须为 off 或 on_demand_mutex，得到 {value!r}")
            acceleration_mode = value
        elif flag == "--threads":
            if not value.isascii() or not value.isdigit():
                raise ValueError(f"--threads 须为正整数，得到 {value!r}")
            threads = int(value, 10)
            if threads <= 0:
                raise ValueError(f"--threads 须为正整数，得到 {value!r}")
        else:
            raise ValueError(f"未知选项: {flag!r}")
    return mps_path, sol_path, time_limit, seed, acceleration_mode, threads


def _cmd_solve(args: list[str]) -> int:
    try:
        mps_path, sol_path, time_limit, seed, acceleration_mode, threads = _parse_solve_args(args)
    except ValueError as exc:
        return _fail(str(exc))
    try:
        handle, model_status = _solve_model(
            mps_path,
            time_limit,
            seed,
            acceleration_mode=acceleration_mode,
            threads=threads,
        )
        _write_solution(handle, model_status, sol_path)
    except Exception as exc:  # 求解链基础设施失败，不伪造输出
        return _fail(f"求解失败: {exc}")
    return 0


def _cmd_self_test(args: list[str]) -> int:
    """``--self-test DIR``：在独立目录完成最小离线自检。"""
    if len(args) != 2:
        return _fail("--self-test 须恰带一个目录参数")
    target = args[1]
    if not os.path.isdir(target):
        return _fail(f"自检目录不存在: {target!r}")
    mps_path = os.path.join(target, SELF_TEST_MPS)
    sol_path = os.path.join(target, SELF_TEST_OUTPUT)
    try:
        with open(mps_path, "w", encoding="utf-8") as stream:
            stream.write(SELF_TEST_MPS_TEXT)
        handle, model_status = _solve_model(mps_path, 60.0, 0)
        _write_solution(handle, model_status, sol_path)
    except Exception as exc:
        return _fail(f"自检求解失败: {exc}")
    ok_status = str(model_status) == "HighsModelStatus.kOptimal"
    try:
        objective = float(handle.getObjectiveValue())
    except Exception:
        objective = float("nan")
    if not ok_status or abs(objective - SELF_TEST_OBJECTIVE) > (SELF_TEST_TOLERANCE):
        sys.stderr.write(f"ies-highs-solver: 自检断言失败 (status={model_status}, objective={objective!r})\n")
        return 1
    if not os.path.isfile(sol_path):
        sys.stderr.write("ies-highs-solver: 自检声明文件未生成\n")
        return 1
    return 0


def main(argv: list[str]) -> int:
    if argv == ["--version"]:
        return _cmd_version()
    if len(argv) == 2 and argv[0] == "--self-test":
        return _cmd_self_test(argv)
    return _cmd_solve(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
