def _set_highs_option(handle, key: str, value) -> None:
    """Apply a HiGHS option and raise immediately if HiGHS rejects it."""
    import highspy

    status = handle.setOptionValue(key, value)
    if status != highspy.HighsStatus.kOk:
        raise RuntimeError(f"HiGHS 无法应用选项 {key}={value!r} (status={status})")


def verify_primal_against_lp(
    lp,
    primals: Sequence[float],
    *,
    feasibility_tolerance: float = 1e-7,
    relative_tolerance: float = 1e-12,
    integrality_tolerance: float = 1e-6,
    original_mutex_overrides: Mapping[str, object] | None = None,
) -> bool:
    """Verify ``primals`` satisfies all variable bounds, integrality, and row bounds of ``lp``."""
    import highspy

    num_col = int(lp.num_col_)
    num_row = int(lp.num_row_)
    if len(primals) != num_col:
        return False
    xs = [float(v) for v in primals]
    if not all(math.isfinite(v) for v in xs):
        return False

    col_overrides: Mapping[int, tuple[float, float, bool]] = (
        original_mutex_overrides.get("cols", {}) if original_mutex_overrides else {}
    )
    row_overrides: Mapping[int, tuple[float, float]] = (
        original_mutex_overrides.get("rows", {}) if original_mutex_overrides else {}
    )
    for col in col_overrides:
        if col < 0 or col >= num_col:
            raise ValueError(f"mutex 列覆盖索引越界: {col!r}")
    for r in row_overrides:
        if r < 0 or r >= num_row:
            raise ValueError(f"mutex 行覆盖索引越界: {r!r}")

    col_lowers = lp.col_lower_
    col_uppers = lp.col_upper_
    integrality = lp.integrality_
    has_integrality = len(integrality) == num_col
    for col in range(num_col):
        val = xs[col]
        if col in col_overrides:
            lo, hi, is_int = col_overrides[col]
        else:
            lo = float(col_lowers[col])
            hi = float(col_uppers[col])
            is_int = has_integrality and integrality[col] == highspy.HighsVarType.kInteger
        if lo > -math.inf and val < lo - (feasibility_tolerance + relative_tolerance * abs(lo)):
            return False
        if hi < math.inf and val > hi + (feasibility_tolerance + relative_tolerance * abs(hi)):
            return False
        if is_int and abs(val - round(val)) > integrality_tolerance:
            return False

    if num_row == 0:
        return True

    matrix = lp.a_matrix_
    starts = matrix.start_
    p_end = matrix.p_end_
    indices = matrix.index_
    values = matrix.value_
    row_sum = array("d", [0.0]) * num_row
    row_comp = array("d", [0.0]) * num_row
    row_abs = array("d", [0.0]) * num_row

    if matrix.format_ == highspy.MatrixFormat.kColwise:
        for col in range(num_col):
            x_val = xs[col]
            if x_val == 0.0:
                continue
            begin = int(starts[col])
            end = (
                int(p_end[col])
                if len(p_end) > col
                else (int(starts[col + 1]) if col + 1 < len(starts) else len(indices))
            )
            for pos in range(begin, end):
                r = int(indices[pos])
                term = float(values[pos]) * x_val
                row_abs[r] += abs(term)
                s = row_sum[r]
                t = s + term
                if abs(s) >= abs(term):
                    row_comp[r] += (s - t) + term
                else:
                    row_comp[r] += (term - t) + s
                row_sum[r] = t
    elif matrix.format_ == highspy.MatrixFormat.kRowwise:
        for r in range(num_row):
            begin = int(starts[r])
            end = (
                int(p_end[r])
                if len(p_end) > r
                else (int(starts[r + 1]) if r + 1 < len(indices) else len(indices))
            )
            row_terms = [float(values[pos]) * xs[int(indices[pos])] for pos in range(begin, end)]
            row_sum[r] = math.fsum(row_terms)
            row_abs[r] = math.fsum(abs(term) for term in row_terms)
    else:
        raise ValueError(f"未知 HiGHS 矩阵存储格式: {matrix.format_!r}")

    row_lowers = lp.row_lower_
    row_uppers = lp.row_upper_
    for r in range(num_row):
        act = row_sum[r] + row_comp[r]
        if not math.isfinite(act):
            return False
        if r in row_overrides:
            lo, hi = row_overrides[r]
        else:
            lo = float(row_lowers[r])
            hi = float(row_uppers[r])
        row_scale = row_abs[r]
        if lo > -math.inf and act < lo - (
            feasibility_tolerance + relative_tolerance * max(row_scale, abs(lo))
        ):
            return False
        if hi < math.inf and act > hi + (
            feasibility_tolerance + relative_tolerance * max(row_scale, abs(hi))
        ):
            return False
    return True


def remaining_solve_budget(
    deadline: float,
    *,
    min_guard: float,
    io_margin: float,
) -> float | None:
    """Return remaining solve budget before ``deadline - io_margin``, or ``None`` if exhausted."""
    if not (math.isfinite(deadline) and math.isfinite(min_guard) and math.isfinite(io_margin)):
        raise ValueError("deadline, min_guard and io_margin must be finite")
    if min_guard < 0 or io_margin < 0:
        raise ValueError("min_guard and io_margin must be non-negative")
    remaining = deadline - time.monotonic()
    if remaining <= min_guard + io_margin:
        return None
    return remaining - io_margin


def _clamp_zero(lower: float, upper: float) -> float:
    if math.isnan(lower) or math.isnan(upper) or lower > upper:
        raise ValueError(f"非法变量上下界: [{lower!r}, {upper!r}]")
    value = min(max(0.0, lower), upper)
    if not math.isfinite(value):
        raise ValueError(f"有限占位值非有限: {value!r} (bounds=[{lower!r}, {upper!r}])")
    return value


def build_partial_warm_start(handle, discrete_values: Mapping[int, float]) -> list[float]:
    """Build full finite warm-start vector clamping unspecified columns to ``[lower, upper]``."""
    lp = handle.getLp()
    num_col = int(lp.num_col_)
    for col, raw in discrete_values.items():
        if not isinstance(col, int) or isinstance(col, bool) or col < 0 or col >= num_col:
            raise ValueError(f"热启动列索引越界: {col!r}")
        if isinstance(raw, bool):
            raise ValueError(f"热启动列 {col} 数值不可为 bool")
        val = float(raw)
        if not math.isfinite(val):
            raise ValueError(f"热启动列 {col} 非有限数值: {raw!r}")

    lowers = lp.col_lower_
    uppers = lp.col_upper_
    col_values: list[float] = []
    for col in range(num_col):
        if col in discrete_values:
            val = float(discrete_values[col])
        else:
            val = _clamp_zero(float(lowers[col]), float(uppers[col]))
        assert math.isfinite(val)
        col_values.append(val)
    return col_values


def inject_warm_start(handle, col_values: Sequence[float]):
    """Validate column length and finiteness before calling ``handle.setSolution``."""
    import highspy

    num_col = int(handle.getNumCol())
    if len(col_values) != num_col:
        raise ValueError(f"热启动列数 {len(col_values)} 与模型列数 {num_col} 不一致")
    validated: list[float] = []
    for idx, raw in enumerate(col_values):
        if isinstance(raw, bool):
            raise ValueError(f"热启动列 {idx} 数值不可为 bool")
        val = float(raw)
        if not math.isfinite(val):
            raise ValueError(f"热启动列 {idx} 非有限数值: {raw!r}")
        validated.append(val)
    solution = highspy.HighsSolution()
    solution.col_value = validated
    solution.value_valid = True
    return handle.setSolution(solution)


def _atomic_write_lines(sol_path: str, lines: Iterator[str]) -> None:
    """Atomically write ``lines`` via same-directory temp file and ``os.replace``."""
    parent = os.path.dirname(sol_path) or "."
    base = os.path.basename(sol_path)
    tmp_path: str | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=parent,
            prefix=f".{base}.",
            suffix=".tmp",
            delete=False,
        ) as stream:
            tmp_path = stream.name
            for line in lines:
                stream.write(line)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp_path, sol_path)
    except BaseException:
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        raise


def _atomic_write_text(sol_path: str, content: str) -> None:
    """Atomically write ``content`` via same-directory temp file and ``os.replace``."""
    _atomic_write_lines(sol_path, iter((content,)))


