{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ies.calculation-config/1.0.0",
  "title": "ies.calculation-config 1.0.0 计算配置目标契约",
  "description": "1.2.0 单向流水线 13 字段 CalculationConfig 契约：包含 mode、predictions、互斥组合（generator+solver 或 algorithm）、并联 evaluators[]、precision、time_limit_seconds、分槽 options、seed（禁止布尔值）和 outputs；移除 convergence，无值字段须显式传 null，未知字段与非有限数值一律拒绝。",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "mode",
    "predictions",
    "generator",
    "solver",
    "algorithm",
    "evaluators",
    "precision",
    "time_limit_seconds",
    "options",
    "seed",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ies.calculation-config" },
    "schema_version": { "const": "1.0.0" },
    "mode": { "type": "string", "minLength": 1 },
    "predictions": {
      "type": "array",
      "description": "单趟前置预测列表，可空列表，不接受 null；target 不得重复。",
      "items": {
        "type": "object",
        "required": ["target", "algorithm", "parameters"],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "object",
            "required": ["instance", "interface"],
            "additionalProperties": false,
            "properties": {
              "instance": { "type": "string", "minLength": 1 },
              "interface": { "type": "string", "minLength": 1 }
            }
          },
          "algorithm": { "$ref": "#/$defs/provider_ref" },
          "parameters": { "type": "object" }
        }
      }
    },
    "generator": {
      "oneOf": [
        { "$ref": "#/$defs/provider_ref" },
        { "type": "null" }
      ]
    },
    "solver": {
      "oneOf": [
        { "$ref": "#/$defs/provider_ref" },
        { "type": "null" }
      ]
    },
    "algorithm": {
      "oneOf": [
        { "$ref": "#/$defs/provider_ref" },
        { "type": "null" }
      ]
    },
    "evaluators": {
      "type": "array",
      "description": "并联后置评价器列表，可空列表，不接受 null；evaluator 引用不得重复。",
      "items": {
        "type": "object",
        "required": ["evaluator", "parameters"],
        "additionalProperties": false,
        "properties": {
          "evaluator": { "$ref": "#/$defs/provider_ref" },
          "parameters": { "type": "object" }
        }
      }
    },
    "precision": { "enum": ["low", "medium", "high"] },
    "time_limit_seconds": { "type": "integer", "exclusiveMinimum": 0 },
    "options": { "type": "object" },
    "seed": { "type": ["integer", "null"] },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "algorithm": { "type": "string" } },
        "required": ["algorithm"]
      },
      "then": {
        "properties": {
          "generator": { "type": "null" },
          "solver": { "type": "null" },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "algorithm": { "type": "object" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "generator": { "$ref": "#/$defs/provider_ref" },
          "solver": { "$ref": "#/$defs/provider_ref" },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "generator": { "type": "object" },
              "solver": { "type": "object" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "provider_ref": {
      "type": "string",
      "description": "<稳定ID>@<语义化版本>；稳定 ID 由点号分隔的非空段组成，段内仅字母、数字、下划线与短横线。",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
