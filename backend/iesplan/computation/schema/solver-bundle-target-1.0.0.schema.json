{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ies.solver-bundle/1.0.0",
  "title": "ies.solver-bundle 1.0.0 求解交接包目标契约",
  "description": "1.2.0 契约解耦 Solver Bundle manifest：bundle{generator, contract}、inputs[{path, media_type}]、outputs[{path, media_type, required}]、extensions；移除 bundle.solver、command 与 result_adapter 硬绑定，路径一律为 Bundle 内安全相对路径，未知字段一律拒绝。",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "bundle",
    "inputs",
    "outputs",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ies.solver-bundle" },
    "schema_version": { "const": "1.0.0" },
    "bundle": {
      "type": "object",
      "description": "生成器精确引用与公开求解包契约标识。",
      "required": ["generator", "contract"],
      "additionalProperties": false,
      "properties": {
        "generator": { "$ref": "#/$defs/provider_ref" },
        "contract": { "$ref": "#/$defs/provider_ref" }
      }
    },
    "inputs": {
      "type": "array",
      "description": "只读输入文件声明。",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "media_type"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "media_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "description": "允许写入的输出清单（须声明 output/primal_solution.json）。",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "media_type", "required"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "media_type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "规范预留的开放扩展点。"
    }
  },
  "$defs": {
    "provider_ref": {
      "type": "string",
      "description": "<稳定ID>@<语义化版本>；稳定 ID 由点号分隔的非空段组成，段内仅字母、数字、下划线与短横线。",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relative_path": {
      "type": "string",
      "description": "Bundle 内相对路径：非空，不以 / 开头，不含反斜杠、空段或 .. 路径段。",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*/$)(?!.*//)(?!.*(^|/)\\.\\.(/|$)).+$"
    }
  }
}
